# ==============================================================================
# Nintendo Retro Vault - Variables de Entorno
# ==============================================================================
# Duplica este archivo como .env.local dentro de nextjs/ para desarrollo:
# cp .env.example nextjs/.env.local
#
# Obtén estos valores en tu panel de Supabase:
# Supabase Dashboard -> Tu Proyecto -> Project Settings -> API
# ==============================================================================

# URL base del proyecto en Supabase (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publica anonima (anon public key) con permisos RLS de solo lectura
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
